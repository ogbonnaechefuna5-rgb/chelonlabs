---
const services = [
  {
    id: "backend",
    title: "Backend Engineering",
    tag: "Core",
    description: "APIs that handle your current traffic and won't break when you scale. We design backend systems that are reliable, secure, and maintainable.",
    items: ["REST & gRPC APIs", "Microservices Architecture", "Database Design & Optimization", "Authentication & Authorization", "Queue Systems & Caching", "Transaction Processing"]
  },
  {
    id: "fintech",
    title: "Payment & Fintech Systems",
    tag: "Specialty",
    description: "Payment infrastructure that processes transactions reliably across multiple providers. From payment flows to settlement and reconciliation.",
    items: ["Payment Gateway Integration", "Multi-Provider Routing", "Virtual Accounts & Wallets", "Settlement & Reconciliation", "AML/KYC Integration", "Transaction Monitoring"]
  },
  {
    id: "integrations",
    title: "API & Integration Engineering",
    description: "Connect your systems to banks, payment providers, and third-party services without building fragile point-to-point connections.",
    items: ["Banking & Payment APIs", "Identity Verification", "Financial Data Providers", "Webhook Infrastructure", "Provider Abstraction Layers", "Error Handling & Retries"]
  },
  {
    id: "infrastructure",
    title: "Cloud & Infrastructure",
    description: "The infrastructure that keeps your systems running. Deployment, scaling, monitoring, and the DevOps practices that make operations predictable.",
    items: ["Docker & Kubernetes", "CI/CD Pipelines", "Cloud Deployment (AWS, GCP)", "Monitoring & Observability", "Performance Optimization", "Cost Management"]
  },
  {
    id: "modernization",
    title: "Backend Modernization",
    description: "Migrate legacy systems, reduce technical debt, and improve performance without breaking what works.",
    items: ["Legacy System Migration", "API Modernization", "Database Migration", "Performance Tuning", "Architecture Refactoring", "Technical Debt Reduction"]
  }
];
---

<section id="services" class="services">
  <div class="container">
    <div class="section-header">
      <span class="section-label">What We Do</span>
      <h2 class="section-title">Engineering Services</h2>
      <p class="section-subtitle">
        We focus on backend systems, APIs, and infrastructure — the technical foundation that everything else depends on.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <div class="service-card" id={service.id}>
          <div class="service-header">
            <h3 class="service-title">{service.title}</h3>
            {service.tag && <span class="service-tag">{service.tag}</span>}
          </div>
          <p class="service-description">{service.description}</p>
          <ul class="service-items">
            {service.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: 6rem 2rem;
    background: var(--color-bg);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 650px;
    margin: 0 auto;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .service-card {
    background: var(--color-bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 1.75rem;
    transition: all 0.3s ease;
  }

  .service-card:hover {
    border-color: rgba(99, 102, 241, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .service-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .service-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .service-tag {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(139, 92, 246, 0.2));
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 4px;
    color: var(--color-primary-light);
  }

  .service-description {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .service-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .service-items li {
    font-size: 0.8rem;
    color: var(--color-text);
    padding: 0.35rem 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
  }

  @media (max-width: 768px) {
    .services {
      padding: 3rem 1rem;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
