---
const metrics = [
  { value: "₦106M+", label: "Monthly transaction volume" },
  { value: "7,500+", label: "Monthly transactions" },
  { value: "6", label: "Payment providers integrated" },
  { value: "763K+", label: "Monthly API calls" },
  { value: "40%", label: "Response time reduction" },
  { value: "25%", label: "Cloud cost reduction" },
];
---

<section class="hero">
  <div class="hero-bg">
    <div class="gradient-orb orb-1"></div>
    <div class="gradient-orb orb-2"></div>
    <div class="grid-pattern"></div>
  </div>
  
  <div class="hero-content container">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      Production Fintech Experience
    </div>
    
    <h1 class="hero-title">
      Backend Engineering for <span class="gradient-text">Fintech & Growing Tech Companies</span>
    </h1>
    
    <p class="hero-subtitle">
      We build payment systems, financial integrations, APIs, and cloud infrastructure 
      for products where reliability, security, and scale matter.
    </p>
    
    <div class="hero-cta">
      <a href="#contact" class="btn btn-primary">Discuss a Project</a>
      <a href="/work" class="btn btn-secondary">See Our Work</a>
    </div>

    <div class="hero-capabilities">
      <span class="capability">Payment Systems</span>
      <span class="divider">/</span>
      <span class="capability">Financial APIs</span>
      <span class="divider">/</span>
      <span class="capability">Backend Infrastructure</span>
      <span class="divider">/</span>
      <span class="capability">Cloud & DevOps</span>
    </div>
  </div>

  <div class="proof-section container">
    <div class="proof-header">
      <span class="proof-label">Built on real production experience</span>
    </div>
    <div class="metrics-grid">
      {metrics.map((metric) => (
        <div class="metric-item">
          <span class="metric-value">{metric.value}</span>
          <span class="metric-label">{metric.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 1rem 3rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.4;
  }

  .orb-1 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.4), transparent 70%);
    top: -100px;
    right: -50px;
  }

  .orb-2 {
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.3), transparent 70%);
    bottom: -50px;
    left: -50px;
  }

  .grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.875rem;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 50px;
    font-size: 0.75rem;
    color: var(--color-primary);
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .hero-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .gradient-text {
    background: linear-gradient(135deg, #6366f1, #a855f7, #6366f1);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradient-shift 3s ease infinite;
  }

  @keyframes gradient-shift {
    0%, 100% { background-position: 0% center; }
    50% { background-position: 100% center; }
  }

  .hero-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    padding: 0 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.5rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s;
    width: 100%;
  }

  .btn-primary {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: white;
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 30px rgba(99, 102, 241, 0.4);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .hero-capabilities {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .capability {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
    padding: 0.3rem 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 20px;
  }

  .divider {
    display: none;
  }

  .proof-section {
    position: relative;
    z-index: 1;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .proof-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .proof-label {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .metric-item {
    text-align: center;
    padding: 0.75rem 0.25rem;
  }

  .metric-value {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.35rem;
    background: linear-gradient(135deg, #f4f4f5, #a1a1aa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .metric-label {
    display: block;
    font-size: 0.65rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Tablet and up */
  @media (min-width: 640px) {
    .hero {
      padding: 7rem 1.5rem 4rem;
    }

    .hero-badge {
      font-size: 0.8rem;
      padding: 0.5rem 1rem;
    }

    .badge-dot {
      width: 8px;
      height: 8px;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-subtitle {
      font-size: 1.1rem;
    }

    .hero-cta {
      flex-direction: row;
      justify-content: center;
      padding: 0;
    }

    .btn {
      width: auto;
      padding: 0.875rem 2rem;
    }

    .capability {
      font-size: 0.85rem;
      padding: 0;
      background: none;
    }

    .divider {
      display: inline;
      color: rgba(255, 255, 255, 0.2);
    }

    .hero-capabilities {
      gap: 1rem;
    }

    .metrics-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .metric-value {
      font-size: 1.5rem;
    }

    .metric-label {
      font-size: 0.7rem;
    }

    .proof-label {
      font-size: 0.8rem;
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .hero {
      padding: 8rem 2rem 4rem;
    }

    .gradient-orb {
      filter: blur(80px);
      opacity: 0.5;
    }

    .orb-1 {
      width: 600px;
      height: 600px;
      top: -200px;
      right: -100px;
    }

    .orb-2 {
      width: 400px;
      height: 400px;
      bottom: -100px;
      left: -100px;
    }

    .grid-pattern {
      background-size: 60px 60px;
    }

    .hero-badge {
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
    }

    .hero-title {
      font-size: 3.5rem;
      margin-bottom: 1.5rem;
    }

    .hero-subtitle {
      font-size: 1.2rem;
      line-height: 1.8;
      margin-bottom: 2.5rem;
    }

    .hero-cta {
      gap: 1rem;
      margin-bottom: 4rem;
    }

    .capability {
      font-size: 0.9rem;
    }

    .proof-section {
      margin-top: 4rem;
      padding-top: 3rem;
    }

    .proof-header {
      margin-bottom: 2rem;
    }

    .proof-label {
      font-size: 0.875rem;
    }

    .metrics-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 1.5rem;
    }

    .metric-item {
      padding: 1rem 0.5rem;
    }

    .metric-value {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    .metric-label {
      font-size: 0.75rem;
    }
  }

  /* Large desktop */
  @media (min-width: 1280px) {
    .hero-title {
      font-size: 4rem;
    }
  }
</style>
