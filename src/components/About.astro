---
const expertise = [
  "Backend Architecture",
  "Fintech Systems", 
  "API Design",
  "Security Engineering",
  "Database Optimization",
  "CI/CD Pipelines",
  "Cloud Infrastructure",
  "System Integration"
];

const techStack = [
  "PHP", "Laravel", "Spiral", "Node.js", "Python", "Go",
  "React", "React Native", "TypeScript",
  "PostgreSQL", "MySQL", "Redis", "MongoDB",
  "Docker", "Kubernetes", "AWS", "Nginx"
];
---

<section id="about" class="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-content">
        <span class="section-label">About Us</span>
        <h2 class="section-title">Engineering Excellence for Business-Critical Systems</h2>
        <p class="about-text">
          Chelon Labs is a specialized software engineering agency. We focus on backend systems, 
          fintech infrastructure, and enterprise integrations — the complex technical work where 
          reliability and security matter most.
        </p>
        <p class="about-text">
          Our team brings deep experience from building payment systems, banking integrations, 
          and scalable architectures. We've seen what breaks at scale and know how to build 
          systems that don't.
        </p>
        
        <div class="differentiators">
          <div class="diff-item">
            <span class="diff-number">01</span>
            <div>
              <h4>Fintech Experience</h4>
              <p>Real-world experience with payment gateways, virtual accounts, settlements, and regulatory compliance.</p>
            </div>
          </div>
          <div class="diff-item">
            <span class="diff-number">02</span>
            <div>
              <h4>Security-First Approach</h4>
              <p>CISO-level thinking baked into every project. Threat modeling, secure architecture, and code review.</p>
            </div>
          </div>
          <div class="diff-item">
            <span class="diff-number">03</span>
            <div>
              <h4>Systems Thinking</h4>
              <p>We understand how your software fits into the broader business. Integrations, workflows, and scale.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="about-sidebar">
        <div class="expertise-card">
          <h3 class="card-title">Core Expertise</h3>
          <div class="expertise-grid">
            {expertise.map((item) => (
              <span class="expertise-tag">{item}</span>
            ))}
          </div>
        </div>

        <div class="tech-card">
          <h3 class="card-title">Technology Stack</h3>
          <div class="tech-grid">
            {techStack.map((tech) => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 6rem 2rem;
    background: var(--color-bg-dark);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .section-label {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .about-text {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }

  .differentiators {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .diff-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .diff-number {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-primary);
    background: rgba(99, 102, 241, 0.1);
    padding: 0.4rem 0.65rem;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .diff-item h4 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .diff-item p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .expertise-card,
  .tech-card {
    background: var(--color-bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 1.75rem;
  }

  .card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .expertise-grid,
  .tech-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .expertise-tag {
    padding: 0.4rem 0.85rem;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(139, 92, 246, 0.15));
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 6px;
    font-size: 0.85rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .tech-tag {
    padding: 0.35rem 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .about {
      padding: 4rem 1.5rem;
    }
  }
</style>
