---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const categoriesData = {
  'custom-software': {
    name: 'Custom Software',
    description: 'Insights on building custom business software, internal systems, and digital transformation.',
    service: '/#services'
  },
  'ai-automation': {
    name: 'AI & Automation',
    description: 'Practical AI applications and workflow automation that saves time and reduces costs.',
    service: '/#services'
  },
  'cybersecurity': {
    name: 'Cybersecurity',
    description: 'Security best practices and threat prevention for businesses.',
    service: '/#services'
  },
  'mobile-apps': {
    name: 'Mobile Apps',
    description: 'Mobile app development insights for iOS and Android.',
    service: '/#services'
  },
  'api-integrations': {
    name: 'API Integrations',
    description: 'Connecting systems, third-party integrations, and API development.',
    service: '/#services'
  },
  'website-development': {
    name: 'Website Development',
    description: 'Building websites that generate leads and grow your business.',
    service: '/#services'
  }
};

export async function getStaticPaths() {
  const cats = ['custom-software', 'ai-automation', 'cybersecurity', 'mobile-apps', 'api-integrations', 'website-development'];
  return cats.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const categoryInfo = categoriesData[category as keyof typeof categoriesData];

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => post.data.category === category)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout title={`${categoryInfo.name} | Chelon Labs Blog`} description={categoryInfo.description}>
  <section class="category-page">
    <div class="container">
      <header class="page-header">
        <a href="/blog" class="back-link">&larr; All Articles</a>
        <span class="section-label">Category</span>
        <h1 class="page-title">{categoryInfo.name}</h1>
        <p class="page-subtitle">{categoryInfo.description}</p>
      </header>

      {posts.length > 0 ? (
        <div class="posts-grid">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="post-card">
              <div class="post-meta">
                <time datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </time>
              </div>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-excerpt">{post.data.description}</p>
              <span class="read-more">Read article &rarr;</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>No articles in this category yet. Check back soon!</p>
          <a href="/blog" class="btn btn-secondary">View All Articles</a>
        </div>
      )}

      <div class="cta-section">
        <h3>Need help with {categoryInfo.name.toLowerCase()}?</h3>
        <p>Let's discuss how we can help your business.</p>
        <a href="/#contact" class="btn btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .category-page {
    padding: 8rem 2rem 4rem;
    min-height: 100vh;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 0.8;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 550px;
    margin: 0 auto;
  }

  .posts-grid {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .post-card {
    display: block;
    background: var(--color-bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 2rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .post-card:hover {
    border-color: rgba(99, 102, 241, 0.3);
    transform: translateY(-4px);
  }

  .post-meta {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .post-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .post-excerpt {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .read-more {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
  }

  .empty-state p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .cta-section {
    text-align: center;
    padding: 3rem;
    background: var(--color-bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
  }

  .cta-section h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .cta-section p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 768px) {
    .category-page {
      padding: 7rem 1.5rem 3rem;
    }

    .post-card {
      padding: 1.5rem;
    }
  }
</style>
